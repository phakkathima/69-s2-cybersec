# REST

## Variables (ค่าทั้งหมดอ่านจาก .env)
@base_url = http://localhost:{{$dotenv APP_PORT}}
@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}
@admin_firstname = {{$dotenv ADMIN_FIRSTNAME}}
@admin_lastname = {{$dotenv ADMIN_LASTNAME}}
@admin_jwt_token = {{$dotenv ADMIN_JWT_TOKEN}}
@user_username = {{$dotenv USER_USERNAME}}
@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}
@user_jwt_token = {{$dotenv USER_JWT_TOKEN}}

## 1.Admin
### 1.1 Login
POST {{base_url}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register (admin) one time for first time to create admin account
# ใช้ได้เฉพาะตอนยังไม่มี admin คนแรกในระบบ (ถ้ามีแล้วจะ error)
POST {{base_url}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "{{admin_firstname}}",
    "lastname": "{{admin_lastname}}",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}

### 1.3 Forgot Password
# ขั้นที่ 1: ขอรีเซ็ตรหัสผ่าน ระบบจะส่งอีเมลที่มีลิงก์ ?code=... ไปที่ ADMIN_EMAIL (ตอบ 204)
POST {{base_url}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password
# ขั้นที่ 2: เอาค่า code จากลิงก์ในอีเมลมาใส่ตอนระบบถาม (ไม่ต้องเก็บใน .env)
# รหัสใหม่ใช้ ADMIN_PASSWORD เดิม จึงตรงกับ .env
# @prompt admin_reset_code code จากลิงก์ในอีเมล (ค่าหลัง ?code=)
POST {{base_url}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{admin_reset_code}}",
    "password": "{{admin_password}}"
}

### 1.4 Profile
GET {{base_url}}/admin/users/me
Authorization: Bearer {{admin_jwt_token}}

## 2.User
### 2.1 Login
POST {{base_url}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.2 Register
POST {{base_url}}/api/auth/local/register
Content-Type: application/json

{
    "username": "{{user_username}}",
    "email": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
# ขั้นที่ 1: ขอรีเซ็ตรหัสผ่าน ระบบจะส่งอีเมลที่มี code ไปที่ USER_EMAIL (ตอบ 200 {"ok":true})
POST {{base_url}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password
# ขั้นที่ 2: เอาค่า code จากอีเมลมาใส่ตอนระบบถาม (ไม่ต้องเก็บใน .env)
# รหัสใหม่ใช้ USER_PASSWORD เดิม จึงตรงกับ .env
# @prompt user_reset_code code จากอีเมล (ค่าหลัง ?code=)
POST {{base_url}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{user_reset_code}}",
    "password": "{{user_password}}",
    "passwordConfirmation": "{{user_password}}"
}

### 2.4 Profile
GET {{base_url}}/api/users/me
Authorization: Bearer {{user_jwt_token}}

## 3.Content
### 3.1 Student
#### 3.1.1 Create
POST {{base_url}}/api/students
Content-Type: application/json
Authorization: Bearer {{user_jwt_token}}

{
    "data": {
        "name": "Student Test",
        "mobile": "0812345678",
        "cardId": "1234567890123"
    }
}

#### 3.1.2 List All
GET {{base_url}}/api/students
Authorization: Bearer {{user_jwt_token}}

#### 3.1.3 List with ID
# เปลี่ยน 1 เป็น id ที่ได้จาก 3.1.1 Create
GET {{base_url}}/api/students/1
Authorization: Bearer {{user_jwt_token}}

#### 3.1.4 Update
# เปลี่ยน 1 เป็น id ที่ได้จาก 3.1.1 Create
PUT {{base_url}}/api/students/1
Content-Type: application/json
Authorization: Bearer {{user_jwt_token}}

{
    "data": {
        "name": "Student Test (updated)",
        "mobile": "0898765432",
        "cardId": "1234567890123"
    }
}

### 3.2 Subject
#### 3.2.1 Create
POST {{base_url}}/api/subjects
Content-Type: application/json
Authorization: Bearer {{user_jwt_token}}

{
    "data": {
        "name": "Subject Test"
    }
}

#### 3.2.2 List All
GET {{base_url}}/api/subjects
Authorization: Bearer {{user_jwt_token}}

#### 3.2.3 List with ID
# เปลี่ยน 1 เป็น id ที่ได้จาก 3.2.1 Create
GET {{base_url}}/api/subjects/1
Authorization: Bearer {{user_jwt_token}}

#### 3.2.4 Update
# เปลี่ยน 1 เป็น id ที่ได้จาก 3.2.1 Create
PUT {{base_url}}/api/subjects/1
Content-Type: application/json
Authorization: Bearer {{user_jwt_token}}

{
    "data": {
        "name": "Subject Test (updated)"
    }
}

### 3.3 Teacher
#### 3.3.1 Create
POST {{base_url}}/api/teachers
Content-Type: application/json
Authorization: Bearer {{user_jwt_token}}

{
    "data": {
        "name": "Teacher Test"
    }
}

#### 3.3.2 List All
GET {{base_url}}/api/teachers
Authorization: Bearer {{user_jwt_token}}

#### 3.3.3 List with ID
# เปลี่ยน 1 เป็น id ที่ได้จาก 3.3.1 Create
GET {{base_url}}/api/teachers/1
Authorization: Bearer {{user_jwt_token}}

#### 3.3.4 Update
# เปลี่ยน 1 เป็น id ที่ได้จาก 3.3.1 Create
PUT {{base_url}}/api/teachers/1
Content-Type: application/json
Authorization: Bearer {{user_jwt_token}}

{
    "data": {
        "name": "Teacher Test (updated)"
    }
}
